# Copy to .env for local development. None of these are secrets:
# Open-Meteo is free and needs no API key. The packaged app ignores this file
# and uses the defaults shown here (except PORT, which is random in the app).

# Port for the standalone dev API server (npm run dev:server / npm run dev)
PORT=5174

# How long to cache Open-Meteo responses, in seconds
CACHE_TTL_WEATHER_SECONDS=600
CACHE_TTL_GEOCODE_SECONDS=86400

# debug | info | warn | error
LOG_LEVEL=info
